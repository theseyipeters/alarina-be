NODE_ENV=development
PORT=5001
# The header holding the visitor's IP address, for rate limits. Leave unset locally. On Render: cf-connecting-ip
# CLIENT_IP_HEADER=
# Local single-node replica set started by `yarn db:up` (transactions need a replica set)
MONGODB_URI=mongodb://127.0.0.1:27018/alarina?replicaSet=rs0
# Origin of the frontend; used for CORS and origin checks
CLIENT_ORIGIN=http://localhost:5173
# Origin of the staff admin app (admin/). Leave unset to switch the admin API off.
ADMIN_ORIGIN=http://localhost:5174
# How long a staff sign-in lasts
ADMIN_SESSION_TTL_HOURS=12
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7
# Optional email delivery (Resend). Leave unset and nothing is emailed: partner invites, guests' RSVP links and
# staff setup links can still be copied from the screen, but password resets never arrive.
# RESEND_API_KEY=
# MAIL_FROM="Alárinà <hello@example.com>"
# Paystack (cash gifts). Use a test key (sk_test_…) in development. Leave unset to switch gifts off.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_FEES_CONFIRMED=false
# In Paystack's dashboard, set the webhook URL to https://<api-host>/api/webhooks/paystack
