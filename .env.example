NODE_ENV=development
PORT=5001
# Local single-node replica set started by `yarn db:up` (transactions need a replica set)
MONGODB_URI=mongodb://127.0.0.1:27018/alarina?replicaSet=rs0
# Origin of the frontend; used for CORS and origin checks
CLIENT_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7
# Optional email delivery (Resend) for partner invites and guests' RSVP links. Leave unset to copy links manually.
# RESEND_API_KEY=
# MAIL_FROM="Alárinà <hello@example.com>"
# Paystack (cash gifts). Use a test key (sk_test_…) in development. Leave unset to switch gifts off.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_FEES_CONFIRMED=false
# In Paystack's dashboard, set the webhook URL to https://<api-host>/api/webhooks/paystack
