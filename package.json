{
  "name": "alarina-be",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "prestart": "node scripts/check-node.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "bash scripts/mongo-rs.sh start",
    "db:down": "bash scripts/mongo-rs.sh stop",
    "db:sync-indexes": "tsx src/scripts/syncIndexes.ts",
    "db:move-same-day-events": "tsx src/scripts/moveSameDayEvents.ts",
    "email:preview": "tsx src/scripts/previewEmails.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "typescript": "~6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1"
  }
}
